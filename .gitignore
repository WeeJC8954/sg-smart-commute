# Flutter app .gitignore (replaces GitHub's "Flutter" template, which is for
# the Flutter SDK repo and wrongly ignores pubspec.lock via *.lock).

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Flutter/Dart/Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android
/android/app/debug
/android/app/profile
/android/app/release
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# Local Claude Code state (worktrees with their own build/ trees, skills)
/.claude/
skills-lock.json

# Secrets / local environment. This project ships no credentials; never
# commit any local key file (e.g. a developer's LTA_ACCOUNT_KEY).
.env
.env.*
*.secret
*.secrets

# busrouter data whose redistribution rights are not established: never commit full copies
# (docs/e5-gate2-implementation-plan.md §2.8, docs/busrouter-fixture-licensing-audit.md).
tool/e5_transfer_bench/**/*.min.json
test/fixtures/busrouter/snapshot-*/
# The busrouter test data is synthetic Dart (test/fixtures/busrouter/README.md); no captured JSON.
test/fixtures/busrouter/**/*.json
# Likewise the OneMap search responses (test/fixtures/onemap/README.md, owner decisions A-4b, A-4c).
test/fixtures/onemap/**/*.json
# The ArriveLah test data is synthetic Dart too (test/fixtures/arrivelah/README.md); no captured JSON.
test/fixtures/arrivelah/**/*.json
