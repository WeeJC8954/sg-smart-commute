# Flutter app .gitignore (replaces GitHub's "Flutter" template, which is for
# the Flutter SDK repo and wrongly ignores pubspec.lock via *.lock).

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# Flutter/Dart/Pub
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication / obfuscation
app.*.symbols
app.*.map.json

# Android
/android/app/debug
/android/app/profile
/android/app/release
**/android/local.properties
**/android/key.properties
*.jks
*.keystore

# Local Claude Code state (worktrees with their own build/ trees, skills)
/.claude/
skills-lock.json

# Secrets / local environment. This project ships no credentials; never
# commit any local key file (e.g. a developer's LTA_ACCOUNT_KEY).
.env
.env.*
*.secret
*.secrets
